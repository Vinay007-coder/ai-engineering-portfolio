# ── Byte-compiled / cache files ──────────────────────────────────────────────
# Compiled bytecode cache dirs; regenerated automatically from .py source
__pycache__/
# Compiled .pyc/.pyo/.pyd files; binary artifacts tied to a specific interpreter version
*.py[cod]
# Jython compiled class files; same reasoning as .pyc
*$py.class

# ── Virtual environments ─────────────────────────────────────────────────────
# Local Python virtual env; huge, OS/machine-specific, rebuildable via requirements.txt
venv/
# Alternate venv naming convention some tools/IDEs create
.venv/
# Another common venv folder name
env/
# Case variant of the above used by some setup scripts
ENV/
# Marker file some venv tools drop referencing the base interpreter
.Python

# ── Packaging / distribution ─────────────────────────────────────────────────
# setuptools/pip build output; generated at package-build time
build/
# Built wheels/sdists; generated artifacts, not source
dist/
# Package metadata generated during install/build
*.egg-info/
# Legacy built egg packages
*.egg
# Temp dir used while building eggs
.eggs/

# ── Environment & secrets ────────────────────────────────────────────────────
# Holds API keys/DB URLs/secrets for local config; must never be committed
.env
# Environment-specific variants (.env.local, .env.production) with same secrets risk
.env.*
# Private keys/certs; committing these leaks credentials
*.pem
# Same as above — private key material
*.key

# ── PyTorch / ML model artifacts ─────────────────────────────────────────────
# Saved PyTorch model weights; large binary, regenerated by training, bloats repo history
*.pt
# Alternate PyTorch checkpoint extension; same reasoning
*.pth
# Training checkpoints (e.g. from Lightning); large and reproducible from training runs
*.ckpt
# Serialized model weights; large binary artifact best stored via model registry/LFS
*.safetensors
# Directory where trained models get saved locally; artifacts, not source code
models/*
# Exception: keep the empty dir tracked so the expected folder structure exists on clone
!models/.gitkeep
# Intermediate training checkpoints; large, ephemeral, tied to a specific training run
checkpoints/
# TensorBoard / experiment run logs; regenerated each training run
runs/
# Weights & Biases local run cache/logs; synced to W&B cloud, not needed in git
wandb/
# MLflow local tracking store; experiment metadata better kept out of git history
mlruns/

# ── Datasets ─────────────────────────────────────────────────────────────────
# Raw/processed datasets; often large and may contain licensed or private data
data/
# Dataset files; regenerate/download rather than version in git
*.csv
# Same as .csv — tabular data dumps
*.tsv
# Columnar data files; large binary, not meant for git diffing
*.parquet
# HDF5 data/model files; large binary blobs
*.h5

# ── Jupyter notebooks ─────────────────────────────────────────────────────────
# Jupyter's autosave checkpoints; transient editor state, not real content
.ipynb_checkpoints/

# ── FastAPI / server runtime artifacts ───────────────────────────────────────
# Application/server log files; runtime output, not source, grows unbounded
*.log
# Local SQLite DB file (e.g. dev/testing); contains runtime data, not schema/code
*.sqlite3
# Generic local database file; same reasoning as sqlite3
*.db
# Flask/FastAPI-style instance folder for local runtime config/uploads
instance/

# ── Testing & coverage ────────────────────────────────────────────────────────
# pytest's internal cache dir; regenerated on each test run
.pytest_cache/
# Coverage.py data file; regenerated by running tests with coverage
.coverage
# HTML coverage report output; generated artifact for viewing coverage
htmlcov/
# tox's per-environment virtualenvs/cache; rebuildable, large
.tox/

# ── Type checking / linting caches ───────────────────────────────────────────
# mypy's incremental type-check cache; safe to regenerate, machine-specific
.mypy_cache/
# ruff linter's cache; regenerated on each lint run
.ruff_cache/

# ── OS-specific junk ──────────────────────────────────────────────────────────
# macOS Finder folder-view metadata; irrelevant to other OSes/collaborators
.DS_Store
# Windows Explorer thumbnail cache; same reasoning as .DS_Store
Thumbs.db

# ── Editor / IDE settings ─────────────────────────────────────────────────────
# VS Code workspace settings; personal editor config, not project-wide standard
.vscode/
# JetBrains IDE project settings; same reasoning, machine/user-specific
.idea/
# Vim swap files; transient editor state left behind on crash/edit
*.swp
